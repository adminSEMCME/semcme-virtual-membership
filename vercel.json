{
  "version": 2,
  "crons": [{ "path": "/api/cron/sync-programs", "schedule": "0 10 * * *" }],
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["data/supabase-ca.crt"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
